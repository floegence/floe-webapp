{
  "name": "@floegence/floe-webapp-boot",
  "version": "0.46.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/floegence/floe-webapp",
    "directory": "packages/boot"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact-source": {
      "types": "./dist/artifact-source.d.ts",
      "import": "./dist/artifact-source.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@floegence/flowersec-core": "3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
